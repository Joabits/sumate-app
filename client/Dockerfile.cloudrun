# Imagen de producción para Cloud Run: compila la app de React y la sirve con el servidor de Node
# (Better Auth en /api/auth y los archivos de dist/). Las URL públicas quedan fijas al compilar.
FROM node:22-slim

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

RUN pnpm build

ENV NODE_ENV=production

# Cloud Run indica el puerto en PORT; server/index.ts lo lee
CMD ["pnpm", "start"]
